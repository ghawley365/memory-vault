# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=memory_vault
DB_USER=memory_vault
DB_PASSWORD=memory_vault

# API
API_HOST=0.0.0.0
API_PORT=8000

# API auth — bearer-token authentication is enabled by default. Generate
# tokens via `memory-vault token create <name>` (the plaintext is shown
# once). Set API_AUTH_ENABLED=false ONLY for local development with a
# trusted network — never expose an unauthenticated instance to the
# public internet.
API_AUTH_ENABLED=true

# Sliding-window rate limit per client IP, per minute. Applies to all
# endpoints except /api/health, /docs, /redoc, /openapi.json.
API_RATE_LIMIT_PER_MIN=120

# CORS origins — comma-separated list of allowed origins for browser
# clients, or "*" for any. The default "*" is intended for local-dev
# only; in production set this to your dashboard's exact origin.
API_CORS_ORIGINS=*

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32

# --- Asymmetric retrieval models (optional) ---------------------------------
# Some embedding models want a task prefix on the text they encode, and a
# different one for queries than for stored documents (e.g. nomic-embed-text).
# Both default to "" — the stock symmetric model needs neither. Prefixes are
# applied at encode time only; stored content never includes them.
# EMBEDDING_QUERY_PREFIX="search_query: "
# EMBEDDING_DOCUMENT_PREFIX="search_document: "
#
# Some models ship their architecture as code in the model repo, which
# transformers will only execute if you opt in. Off by default.
# EMBEDDING_TRUST_REMOTE_CODE=false
#
# Pin the Hub revision (commit sha) the model — and, under
# TRUST_REMOTE_CODE, its architecture code — is loaded from. Unset means
# whatever the model repo currently serves on 'main'.
# EMBEDDING_MODEL_REVISION=
#
# Cap the model's token context. 0 keeps the model default; long-context
# models (8192 tokens) can request tens of GiB of attention memory on a full
# batch, so cap them (e.g. 2048) to keep embedding memory bounded.
# EMBEDDING_MAX_SEQ_LENGTH=0
#
# Changing EMBEDDING_MODEL/EMBEDDING_DIMENSIONS: migration 009 converts the
# vector column to EMBEDDING_DIMENSIONS and NULLs the now-meaningless
# vectors. Run `memory-vault reembed` straight after `memory-vault migrate`.

# Search
RRF_K=60
SEARCH_DEFAULT_LIMIT=10

{
  "mcpServers": {
    "memory-vault": {
      "command": "python",
      "args": [
        "-m",
        "memory_vault.mcp"
      ],
      "cwd": "/path/to/memory-vault",
      "env": {
        "DB_HOST": "localhost",
        "DB_PORT": "5432",
        "DB_NAME": "memory_vault",
        "DB_USER": "memory_vault",
        "DB_PASSWORD": "memory_vault"
      }
    }
  }
}
